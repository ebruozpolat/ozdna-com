{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ozdna-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ozdna",
      "database_id": "515e201d-1b18-497d-923c-7dec053ada48",
      "migrations_dir": "../../migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
